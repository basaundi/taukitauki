<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            A minimal transparent Settings activity is required by some Android versions
            to display the IME in the keyboard picker. Without it the keyboard may appear
            in Settings > Language & Input but not in the runtime picker overlay.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="TaukiTauki Settings"
            android:theme="@style/Theme.AppCompat.Light">
        </activity>

        <service
            android:name=".TaukiTaukiService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
