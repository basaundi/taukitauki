<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/candidates_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#1a1a1a"
        android:orientation="horizontal"
        android:visibility="visible">

        <Button
            android:id="@+id/btn_paste_or_suggest"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="@string/label_paste"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/sug1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/candidate_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#555555" />

        <TextView
            android:id="@+id/sug2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/candidate_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#555555" />

        <TextView
            android:id="@+id/sug3"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/candidate_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#555555" />

        <TextView
            android:id="@+id/sug4"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/candidate_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#555555" />

        <TextView
            android:id="@+id/sug5"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/candidate_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <eus.basaundi.taukitauki.TaukiTaukiView
        android:id="@+id/taukitauki_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="220dp" />
</LinearLayout>
